<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:UVCControl.App.ViewModels"
        xmlns:views="using:UVCControl.App.Views"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
        x:Class="UVCControl.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="UVC Control"
        Width="1100" Height="780" MinWidth="820" MinHeight="560">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:DeviceViewModel">
            <views:DeviceView />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="240,Auto,*">
        <!-- Sidebar -->
        <DockPanel Background="{DynamicResource SidebarBackground}">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="14,12,10,6">
                <TextBlock Classes="sectionHeader" Text="CAMERAS" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Rescan" Command="{Binding RescanCommand}"
                        ToolTip.Tip="Look for connected cameras again" />
            </Grid>
            <TextBlock DockPanel.Dock="Bottom" Classes="caption secondary" Margin="14,8"
                       Text="{Binding BackendName}" />
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsScanning}"
                         Margin="14,0" MinHeight="2" Height="2" />
            <Panel>
                <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                         Background="Transparent" Margin="6,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:DeviceViewModel">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="caption secondary mono" Text="{Binding VidPid}" />
                                    <TextBlock Classes="caption secondary" Text="{Binding StatusText}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel IsVisible="{Binding ShowNoDevices}" VerticalAlignment="Center" Margin="20" Spacing="6">
                    <TextBlock Text="No UVC Cameras" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Classes="secondary" Text="Connect a camera and press Rescan."
                               TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Panel>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="1" ResizeDirection="Columns" Background="{DynamicResource CardBorder}" />

        <!-- Detail -->
        <Panel Grid.Column="2" Background="{DynamicResource PageBackground}">
            <ContentControl Content="{Binding SelectedDevice}" />
            <TextBlock Classes="secondary" Text="Select a Camera" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding !HasSelection}" />
        </Panel>
    </Grid>
</Window>
